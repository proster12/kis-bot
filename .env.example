# 이 파일을 .env 로 복사한 뒤 값을 채우세요. .env 는 절대 커밋·공유하지 마세요 (.gitignore에 포함).
# 모드: paper(모의투자) / live(실전). 자동매매 봇(trader.py, kr_trader.py)은 paper에서만 동작합니다.
KIS_MODE=paper
# KIS Developers에서 발급받은 App Key / App Secret
KIS_APP_KEY=
KIS_APP_SECRET=
# 계좌번호 (앞 8자리-뒤 2자리)
KIS_ACCOUNT=12345678-01
# 주문 1건 최대 금액. 코드에 버그가 있어도 이 금액을 넘는 매수는 거부됨
KIS_MAX_ORDER_USD=500
KIS_MAX_ORDER_KRW=500000
